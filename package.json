{
  "name": "markdown-diff",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/example-page.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "check:performance": "node scripts/check-performance.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check": "npm run lint && npm run check:performance && npm test && npm run build && npm run check:size && playwright test"
  },
  "dependencies": {
    "diff": "9.0.0",
    "hast-util-from-html": "2.1.0",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.6",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "vite": "7.3.8"
  }
}
